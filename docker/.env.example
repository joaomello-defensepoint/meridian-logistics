# Langfuse self-hosted configuration for the AI Observability demo.
# Copy this file to `.env` before `docker compose up`:
#     cp docker/.env.example docker/.env
#
# These are DEMO values — fine for a local presentation. For anything real,
# regenerate ENCRYPTION_KEY (openssl rand -hex 32) and change the passwords/keys.

NEXTAUTH_URL=http://localhost:3001

# Secrets (demo values)
NEXTAUTH_SECRET=meridian-demo-nextauth-secret
SALT=meridian-demo-salt
ENCRYPTION_KEY=29f7c70fa9a64d63db9768bebeef9fa91a5b15e827ae48e32b468b5d327df537

TELEMETRY_ENABLED=false

# Auto-provision an org, project, user and API keys on first start,
# so the demo app works out of the box with no manual setup in the UI.
LANGFUSE_INIT_ORG_ID=defensepoint
LANGFUSE_INIT_ORG_NAME=DefensePoint
LANGFUSE_INIT_PROJECT_ID=meridian-logistics
LANGFUSE_INIT_PROJECT_NAME=Meridian Logistics
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-meridian-demo
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-meridian-demo
LANGFUSE_INIT_USER_EMAIL=joao@defensepoint.com
LANGFUSE_INIT_USER_NAME=Joao
LANGFUSE_INIT_USER_PASSWORD=MeridianDemo1!
